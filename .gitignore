# Ignore files used by bash scripts
.env

# Ignore files created by Python
.venv
venv/
__pycache__/
*.py[codz]
*$py.class
.pytest_cache/
.ruff_cache/

# Ignore files created by IDE's
.vscode/
.devcontainer*
.theia/
.Trash*

# Ignore GIT files
.worktree/

# Ignore OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
.cache/
known_hosts
nohup.out
$RECYCLE.BIN/
[Dd]esktop.ini
*~

# Ignore compiled source
*.com
*.class
*.dll
*.exe
*.o
*.so
*.rpm

# Ignore packages
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
!gradle-wrapper.jar
*.rar
*.tar
*.tar.gz
*.tgz
*.zip

# Ignore Logs and databases
*.log.*
*.sql
*.sqlite
*.db*
