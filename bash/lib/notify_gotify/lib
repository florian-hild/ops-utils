#!/usr/bin/env bash

#-------------------------------------------------------------------------------
# Author     : Florian Hild
# Created    : 16-05-2025
# Description: Library to send notifications to a Gotify server
#              Supports priority levels and JSON message formatting
#-------------------------------------------------------------------------------

export LANG=C

if [[ "${0}" == "${BASH_SOURCE[0]}" ]]; then
  echo "This script must be sourced, not executed." >&2
  exit 1
fi

# Configuration variables with defaults
GOTIFY_SERVER_URL="${GOTIFY_SERVER_URL:-https://gotify.lan.florian-hild.de}"
GOTIFY_API_KEY="${GOTIFY_API_KEY:-}"

import() {
    local module="${1}"
    # shellcheck disable=SC2155
    local lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    local lib_base_dir="${lib_dir}/.."
    local lib_file="${lib_base_dir}/${module}/lib"

    if [[ ! -f "${lib_file}" ]]; then
        echo "Error: Module '${module}' not found at '${lib_file}'" >&2
        exit 1
    fi

    # shellcheck disable=SC1090
    source "${lib_file}"
}

# Import the logger library
import logger

# Sends a notification to Gotify server
# Arguments:
#   $1 - Priority level: info, warn, warning, error, critical (or numeric 0-10)
#   $2 - Notification title
#   $3 - Message body (supports \n for newlines)
# Environment Variables:
#   GOTIFY_SERVER_URL - Gotify server URL (default: https://gotify.lan.florian-hild.de)
#   GOTIFY_API_KEY    - Gotify application token
# Returns:
#   0 - Success
#   1 - Invalid arguments or request failed
send_alert() {
    local priority="${1:-info}"
    local title="${2:-No title provided!}"
    local message="${3:-No message provided!}"
    local priority_number=""
    local escaped_message=""
    local escaped_title=""
    local payload=""
    local json_response=""
    local http_code=""
    local json_body=""
    local rc=0

    # Validate required arguments
    if [[ ${#} -lt 3 ]]; then
        log "error" "Missing required arguments"
        log "info"  "Usage:"
        log "info"  "  send_alert <priority> <title> <message>"
        log "info"  "Arguments:"
        log "info"  "  priority     Notification level: info, warn, warning, error, critical"
        log "info"  "  title        Short title for the Gotify notification"
        log "info"  "  message      Detailed message body"
        return 1
    fi

    if [[ -z "${GOTIFY_API_KEY// }" ]]; then
        log "error" "GOTIFY_API_KEY environment variable is not set"
        return 1
    fi

    # Normalize priority to lowercase using Bash parameter expansion
    priority="${priority,,}"

    # Map priority levels to Gotify priority numbers
    case "${priority}" in
        info|0)
            priority_number="0"
            ;;
        warn|warning|1|2|3)
            priority_number="3"
            ;;
        error|4|5|6|7)
            priority_number="7"
            ;;
        critical|8|9|10)
            priority_number="10"
            ;;
        *)
            log "error" "Invalid priority: '${priority}'"
            log "info"  "Supported values: info, warn, warning, error, critical (or 0-10)"
            priority_number="7"
            message="Invalid priority: '${priority}'\n\n${message}"
            ;;
    esac

    log "info" "Sending notification to Gotify server: '${GOTIFY_SERVER_URL}'"
    log "debug" "Priority: '${priority}' (${priority_number})"
    log "debug" "Title: '${title}'"

    # Convert escape sequences to actual newlines
    message="$(printf "%b" "${message}")"

    # Escape message and title for JSON
    escaped_message="$(printf '%s' "${message}" | sed 's/\\/\\\\/g; s/"/\\"/g; s/$/\\n/' | tr -d '\n')"
    escaped_title="$(printf '%s' "${title}" | sed 's/\\/\\\\/g; s/"/\\"/g')"

    # Build JSON payload
    payload=$(cat <<EOF
{
    "title": "${escaped_title}",
    "message": "${escaped_message}",
    "priority": ${priority_number}
}
EOF
    )

    log "debug" "Payload size: ${#payload} bytes"

    # Send notification via curl
    json_response="$(curl -sS -w "%{http_code}" -X POST "${GOTIFY_SERVER_URL}/message?token=${GOTIFY_API_KEY}" \
        -H "Content-Type: application/json" \
        -d "${payload}" 2>&1)"
    rc=${?}

    # Extract HTTP status code (last 3 characters)
    http_code="${json_response: -3}"

    # Extract JSON response body (everything except last 3 characters)
    json_body="${json_response:0:-3}"

    # Check for errors
    if [[ "${rc}" -ne 0 ]]; then
        log "error" "curl command failed with exit code: ${rc}"
        log "error" "HTTP response code: ${http_code}"
        log "error" "Response: ${json_response}"
        return 1
    fi

    if [[ "${http_code}" -ge 400 ]]; then
        log "error" "Gotify request failed with HTTP code: ${http_code}"
        log "error" "Response body: ${json_body}"
        return 1
    fi

    log "info" "Notification sent successfully"
    log "debug" "HTTP response code: ${http_code}"
    log "debug" "Response: ${json_body}"
    return 0
}
